:root, [data-theme="light"] { --text-xs: clamp(0.75rem, 0.7rem + 0.25vw, 0.875rem); --text-sm: clamp(0.875rem, 0.8rem + 0.35vw, 1rem); --text-base: clamp(1rem, 0.95rem + 0.25vw, 1.125rem); --text-lg: clamp(1.125rem, 1rem + 0.75vw, 1.5rem); --text-xl: clamp(1.5rem, 1.2rem + 1.25vw, 2.25rem); --space-1: 0.25rem; --space-2: 0.5rem; --space-3: 0.75rem; --space-4: 1rem; --space-6: 1.5rem; --space-8: 2rem; --space-12: 3rem; --color-bg: #f7f6f2; --color-surface: #f9f8f5; --color-surface-2: #fbfbf9; --color-border: #d4d1ca; --color-text: #28251d; --color-text-muted: #7a7974; --color-primary: #01696f; --color-primary-hover: #0c4e54; --color-primary-highlight: #cedcd8; --color-success: #437a22; --color-warning: #964219; --radius-md: 0.5rem; --radius-lg: 0.75rem; --radius-full: 9999px; --shadow-md: 0 4px 12px rgba(0,0,0,.08); --font-body: 'Satoshi', system-ui, sans-serif; --font-display: 'Cabinet Grotesk', 'Satoshi', sans-serif; }

[data-theme="dark"] { --color-bg: #171614; --color-surface: #1c1b19; --color-surface-2: #201f1d; --color-border: #393836; --color-text: #cdccca; --color-text-muted: #797876; --color-primary: #4f98a3; --color-primary-hover: #227f8b; --color-primary-highlight: #313b3b; --color-success: #6daa45; --color-warning: #bb653b; --shadow-md: 0 4px 12px rgba(0,0,0,.3); }

*, ::before, ::after { box-sizing: border-box; }

body, h1, h2, h3, p, pre, textarea, button { margin: 0px; }

body { font-family: var(--font-body); background: var(--color-bg); color: var(--color-text); line-height: 1.6; min-height: 100vh; }

button, textarea { font: inherit; }

button { cursor: pointer; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; }

.wrap { max-width: 1100px; margin: 0px auto; padding: var(--space-6); }

.skip { position: absolute; left: -9999px; }

.skip:focus { left: var(--space-4); top: var(--space-4); background: var(--color-surface); padding: var(--space-2) var(--space-3); border-radius: var(--radius-md); }

header { display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); padding: var(--space-4) 0 var(--space-6); }

.brand { display: flex; align-items: center; gap: var(--space-3); }

.logo { width: 42px; height: 42px; color: var(--color-primary); }

.title { font-family: var(--font-display); font-size: var(--text-xl); line-height: 1.05; }

.muted { color: var(--color-text-muted); }

.btn { padding: 0.8rem 1rem; border-radius: var(--radius-full); min-height: 44px; min-width: 44px; transition: 0.18s; display: inline-flex; align-items: center; gap: 0.5rem; }

.btn-primary { background: var(--color-primary); color: white; }

.btn-primary:hover { background: var(--color-primary-hover); }

.btn-secondary { background: var(--color-surface-2); color: var(--color-text); border: 1px solid var(--color-border); }

.hero { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: var(--space-6); align-items: start; padding-bottom: var(--space-6); }

.card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-md); }

.panel { padding: var(--space-6); }

.pill { display: inline-flex; padding: 0.35rem 0.7rem; border-radius: var(--radius-full); background: var(--color-primary-highlight); color: var(--color-text); font-size: var(--text-xs); margin-bottom: var(--space-3); }

.features { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); margin-top: var(--space-4); }

.feature { padding: var(--space-4); background: var(--color-surface-2); border-radius: var(--radius-lg); border: 1px solid var(--color-border); }

.grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-6); margin-top: var(--space-6); }

textarea { width: 100%; min-height: 280px; padding: var(--space-4); background: var(--color-surface-2); color: var(--color-text); border: 1px solid var(--color-border); border-radius: var(--radius-md); resize: vertical; }

pre { white-space: pre-wrap; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 14px; background: var(--color-surface-2); border: 1px solid var(--color-border); padding: var(--space-4); border-radius: var(--radius-md); min-height: 280px; }

.actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-4); }

.lesson { margin-top: var(--space-6); padding: var(--space-4); border-top: 1px solid var(--color-border); }

.lesson ul { padding-left: 1.2rem; }

@media (max-width: 860px) {
  .hero, .grid, .features { grid-template-columns: 1fr; }
  .wrap { padding: var(--space-4); }
  .title { max-width: 12ch; }
}
